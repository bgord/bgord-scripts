{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "./bgord-scripts/test.sh --bail",
    "timeoutMS": 5000
  },
  "mutate": ["src/**/*.ts", "modules/**/*.ts", "app/http/**/*.ts", "!tests/**", "!**/_setup.ts"],
  "ignorePatterns": ["/tmp", "/reports", "/.fallow", "/.auth", "/.cspellcache", "/*.db*"],
  "reporters": ["clear-text", "progress", "html"],
  "coverageAnalysis": "off",
  "incremental": true,
  "concurrency": 5,
  "timeoutMS": 5000,
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json"
}
