{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "bgord-scripts/*",
    "tests/fixtures/*",
    "tests/_setup.ts",
    "public/*",
    "output/*",
    "src/**/*.css",
    "web/entry-client.tsx"
  ],
  "ignoreDependencies": [
    "@bgord/bun",
    "@bgord/design",
    "@bgord/tools",
    "@bgord/ui",
    "better-auth",
    "iconoir-react",
    "react",
    "better-sqlite3",
    "@fullhuman/postcss-purgecss",
    "postcss",
    "@happy-dom/global-registrator",
    "@stryker-mutator/typescript-checker",
    "croner",
    "gzip-cli",
    "hono",
    "lightningcss-cli",
    "lockfile-lint",
    "monocart-coverage-reports",
    "nodemailer",
    "shellcheck",
    "actions-up",
    "valibot",
    "publint",
    "temporal-polyfill",
    "@react-email/components",
    "@react-email/body",
    "@react-email/button",
    "@react-email/column",
    "@react-email/container",
    "@react-email/head",
    "@react-email/hr",
    "@react-email/html",
    "@react-email/link",
    "@react-email/preview",
    "@react-email/render",
    "@react-email/row",
    "@react-email/section",
    "@react-email/text"
  ],
  "entry": [
    "index.ts",
    "app/**/*.ts",
    "modules/**/*.ts",
    "infra/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "bench/**/*.ts"
  ]
}
